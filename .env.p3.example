# P3 Arbitrage Lab — STRICT DRY by default; guarded LIVE capability opt-in
P3_P26_DB_PATH=data/p26_research.sqlite
P3_DB_PATH=data/p3_arbitrage.sqlite
P3_REPORTS_DIR=reports/p3

# Structural parity scanner
P3_SCANNER_ENABLED=true
P3_SCAN_INTERVAL_MS=250
P3_MAX_BOOK_AGE_MS=750
P3_MAX_SOURCE_SKEW_MS=500
P3_MIN_NET_PROFIT_USDC=0.0
P3_MIN_NET_ROI=0.0
P3_EXECUTION_BUFFER_PER_SHARE=0.0
P3_MAX_QUANTITY_SHARES=500
P3_MAX_CAPITAL_PER_CYCLE_USDC=20
P3_WINDOW_GRACE_MS=500

# Replay / strict confirmation
P3_REPLAY_DELAYS_MS=10,25,50,100,200,500
P3_REPLAY_SNAPSHOT_TOLERANCE_MS=250
P3_REPLAY_BATCH_SIZE=200
P3_REPLAY_RUNTIME_BATCH_SIZE=20
P3_DRY_ENABLED=true
P3_DRY_LATENCY_MS=100
P3_DRY_ENTRY_CONFIRM_MS=250
P3_DRY_CONFIRM_MAX_GAP_MS=400
P3_DRY_SURVIVAL_DELAYS_MS=0,50,100,200,250,500
P3_DRY_START_BANKROLL_USDC=100
P3_DRY_MIN_NET_PROFIT_USDC=0.01
P3_DRY_MIN_NET_ROI=0.0025

# STRICT readiness gates
P3_READINESS_MIN_WINDOWS=100
P3_READINESS_MIN_PAIR_COMPLETION=0.97
P3_READINESS_MIN_PAIR_WILSON_LOWER=0.90
P3_READINESS_MAX_ONE_LEG_RATE=0.03
P3_READINESS_MAX_DRAWDOWN_USDC=5

# Main read-only Turkish analytics dashboard
P3_WEB_ENABLED=true
P3_WEB_HOST=127.0.0.1
P3_WEB_PORT=8093
P3_WEB_REFRESH_MS=3000

# -----------------------------------------------------------------------------
# GUARDED LIVE v1 — defaults are deliberately OFF.
# LIVE v1 supports BUY+MERGE only. SPLIT+SELL remains disabled.
# The process ALWAYS starts DRY after restart/deploy and must be armed manually.
# -----------------------------------------------------------------------------
P3_LIVE_FEATURE_ENABLED=false
P3_LIVE_AUTO_EXECUTE_ENABLED=false
P3_LIVE_REQUIRE_DRY_VALIDATED=true
P3_LIVE_BUY_MERGE_ONLY=true
P3_LIVE_MAX_CAPITAL_PER_CYCLE_USDC=1.00
P3_LIVE_MAX_QUANTITY_SHARES=10
P3_LIVE_MIN_NET_PROFIT_USDC=0.01
P3_LIVE_MIN_NET_ROI=0.0025
P3_LIVE_POLL_INTERVAL_MS=100
P3_LIVE_SETTLEMENT_WAIT_SEC=15
P3_LIVE_SETTLEMENT_POLL_SEC=0.5
P3_LIVE_CLOB_HOST=https://clob.polymarket.com
P3_LIVE_CHAIN_ID=137
P3_LIVE_GEOBLOCK_URL=https://polymarket.com/api/geoblock
P3_LIVE_REQUIRE_GEOBLOCK_CLEAR=true

# One-click operator controls are intentionally localhost-only. Use an SSH tunnel;
# do NOT expose 8094 in the EC2 security group or reverse proxy.
P3_LIVE_CONTROL_ENABLED=true
P3_LIVE_CONTROL_HOST=127.0.0.1
P3_LIVE_CONTROL_PORT=8094

# LIVE secrets (ONLY in the VPS .env.p3; NEVER commit real values).
# Preferred names are below. Official SDK-compatible fallback names PK/CLOB_* are
# also accepted by the code.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_WALLET=
POLYMARKET_FUNDER=
POLYMARKET_SIGNATURE_TYPE=0
POLYMARKET_CLOB_API_KEY=
POLYMARKET_CLOB_API_SECRET=
POLYMARKET_CLOB_API_PASSPHRASE=
