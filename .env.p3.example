# P3 Arbitrage Lab — STRICT DRY by default; guarded LIVE capability opt-in
P3_P26_DB_PATH=data/p26_research.sqlite
P3_DB_PATH=data/p3_arbitrage.sqlite
P3_REPORTS_DIR=reports/p3

# Structural parity scanner
P3_SCANNER_ENABLED=true
P3_SCAN_INTERVAL_MS=250
P3_MAX_BOOK_AGE_MS=750
P3_MAX_SOURCE_SKEW_MS=500
P3_MIN_NET_PROFIT_USDC=0.0
P3_MIN_NET_ROI=0.0
P3_EXECUTION_BUFFER_PER_SHARE=0.0
P3_MAX_QUANTITY_SHARES=500
P3_MAX_CAPITAL_PER_CYCLE_USDC=20
P3_WINDOW_GRACE_MS=500

# Replay / strict confirmation
P3_REPLAY_DELAYS_MS=10,25,50,100,200,500
P3_REPLAY_SNAPSHOT_TOLERANCE_MS=250
P3_REPLAY_BATCH_SIZE=200
P3_REPLAY_RUNTIME_BATCH_SIZE=20
P3_DRY_ENABLED=true
P3_DRY_LATENCY_MS=100
P3_DRY_ENTRY_CONFIRM_MS=250
P3_DRY_CONFIRM_MAX_GAP_MS=400
P3_DRY_SURVIVAL_DELAYS_MS=0,50,100,200,250,500
P3_DRY_START_BANKROLL_USDC=100
P3_DRY_MIN_NET_PROFIT_USDC=0.01
P3_DRY_MIN_NET_ROI=0.0025

# STRICT readiness gates
P3_READINESS_MIN_WINDOWS=100
P3_READINESS_MIN_PAIR_COMPLETION=0.97
P3_READINESS_MIN_PAIR_WILSON_LOWER=0.90
P3_READINESS_MAX_ONE_LEG_RATE=0.03
P3_READINESS_MAX_DRAWDOWN_USDC=5

# Main Turkish analytics + operator dashboard. /health stays minimal for local smoke.
P3_WEB_ENABLED=true
P3_WEB_HOST=127.0.0.1
P3_WEB_PORT=8093
P3_WEB_REFRESH_MS=3000
P3_WEB_AUTH_REQUIRED=false
P3_WEB_USERNAME=operator
P3_WEB_PASSWORD=
P3_WEB_SESSION_TTL_SEC=43200
P3_WEB_LOGIN_MAX_FAILURES=5
P3_WEB_LOGIN_WINDOW_SEC=600
# Set true only when the browser reaches 8093 through HTTPS/TLS.
P3_WEB_COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# GUARDED LIVE v2 — defaults are deliberately OFF.
# BUY+MERGE only. UP and DOWN ALWAYS submit the same exact share quantity.
# Q = min(STRICT optimum, target, hard max, fresh UP depth, fresh DOWN depth).
# Dollar notional is derived from Q; the old $1 proportional scaler is disabled.
# -----------------------------------------------------------------------------
P3_LIVE_FEATURE_ENABLED=false
P3_LIVE_AUTO_EXECUTE_ENABLED=false
P3_LIVE_REQUIRE_DRY_VALIDATED=true
P3_LIVE_BUY_MERGE_ONLY=true

# Equal-share sizing. First production profile targets 5 shares each leg.
P3_LIVE_TARGET_QUANTITY_SHARES=5
P3_LIVE_MAX_QUANTITY_SHARES=10

# Deprecated v1 variable: accepted for old .env compatibility but NOT used for sizing.
P3_LIVE_MAX_CAPITAL_PER_CYCLE_USDC=0

# Fresh-book edge gates after equal-share sizing.
P3_LIVE_MIN_NET_PROFIT_USDC=0.01
P3_LIVE_MIN_NET_ROI=0.0025

# Single-leg safety envelope.
P3_LIVE_MIN_COLLATERAL_TO_ARM_USDC=5.00
P3_LIVE_MAX_SINGLE_LEG_NOTIONAL_USDC=5.25
P3_LIVE_MAX_PROJECTED_UNWIND_LOSS_USDC=0.25
P3_LIVE_EMERGENCY_UNWIND_LOSS_USDC=0.50
P3_LIVE_MIN_EDGE_TO_UNWIND_LOSS_RATIO=0.10
P3_LIVE_EMERGENCY_FAK_ENABLED=true
# After ANY one-leg risk event, flatten first then halt for operator review.
P3_LIVE_HALT_AFTER_ONE_LEG=true
# Gross realized losses over rolling 24h; profits do not reset this kill-switch.
P3_LIVE_ROLLING_24H_GROSS_LOSS_LIMIT_USDC=2.00

P3_LIVE_POLL_INTERVAL_MS=100
P3_LIVE_SETTLEMENT_WAIT_SEC=15
P3_LIVE_SETTLEMENT_POLL_SEC=0.5
P3_LIVE_CLOB_HOST=https://clob.polymarket.com
P3_LIVE_CHAIN_ID=137
P3_LIVE_GEOBLOCK_URL=https://polymarket.com/api/geoblock
P3_LIVE_REQUIRE_GEOBLOCK_CLEAR=true

# Deprecated old 8094 knobs: retained only so older .env files parse cleanly.
P3_LIVE_CONTROL_ENABLED=false
P3_LIVE_CONTROL_HOST=127.0.0.1
P3_LIVE_CONTROL_PORT=8094

# LIVE secrets (ONLY in the VPS .env.p3; NEVER commit real values).
# WhaleSignal defaults to the official deposit-wallet / POLY_1271 flow:
# signature type 3 + funder/deposit-wallet address.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_WALLET=
POLYMARKET_FUNDER=
POLYMARKET_SIGNATURE_TYPE=3
POLYMARKET_CLOB_API_KEY=
POLYMARKET_CLOB_API_SECRET=
POLYMARKET_CLOB_API_PASSPHRASE=
