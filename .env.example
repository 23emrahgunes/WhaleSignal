PORT=8080
DB_PATH=data/tv_direction.sqlite
POLYMARKET_POLL_SEC=15
LOG_LEVEL=info

# Paper-only portfolio simulation (NO live orders)
PAPER_ENABLED=true
PAPER_INITIAL_BALANCE=1000
PAPER_STAKE=2.50
PAPER_MIN_CONFIDENCE=55
PAPER_MIN_SECONDS_TO_END=30
PAPER_MAX_SECONDS_TO_END=240

# Realistic paper BUY execution: CLOB ask/VWAP + fee + latency buffer
PAPER_TAKER_FEE_RATE=0.07
PAPER_LATENCY_BUFFER=0.002
# Hard paper-entry economics: fee/latency-inclusive cost and PTB terminal edge
PAPER_MAX_EFFECTIVE_ENTRY=0.85
PAPER_MIN_ECONOMIC_EDGE=0.05

# Shadow reverse hedge. This never sends a live order and never reacts to one flip.
PAPER_HEDGE_ENABLED=true
PAPER_HEDGE_WINDOW=8
PAPER_HEDGE_MIN_VOTES=6
PAPER_HEDGE_MIN_CONSECUTIVE=3
PAPER_HEDGE_SCORE_THRESHOLD=0.35
PAPER_HEDGE_MIN_PROBABILITY=0.65
PAPER_HEDGE_MIN_EDGE=0.03
PAPER_HEDGE_MIN_ABS_PTB_Z=0.50
PAPER_HEDGE_MIN_SECONDS_TO_END=20
PAPER_HEDGE_MAX_SECONDS_TO_END=120


# Maker arbitrage shadow engine. NO live orders are submitted.
# Maker fee is modeled as zero; operational buffer remains conservative.
ARB_SHADOW_ENABLED=true
ARB_TARGET_EDGE=0.02
# Paper research samples smaller positive maker edges; this is NOT a live threshold.
ARB_PAPER_MIN_EDGE=0.002
ARB_OPERATIONAL_BUFFER=0.002
ARB_UNCERTAINTY_PENALTY=0.02
# One unit = max(UP min_order_size, DOWN min_order_size), normally 5 shares.
ARB_MAX_STRANDED_UNITS=1


# Maker arbitrage paper executor (still NO live orders)
ARB_MAX_BOOK_FETCH_MS=1000
ARB_TRADE_STREAM_MAX_AGE_SEC=20
ARB_PAPER_ENABLED=true
ARB_PAPER_ORDER_TTL_SEC=12
ARB_PAPER_MAX_STRANDED_SEC=5
ARB_PAPER_STOP_BEFORE_END_SEC=12

# Arb v2 completion-probability / CycleEV policy
ARB_PAPER_SOFT_COMPLETION_SEC=2
ARB_COMPLETION_LOOKBACK=500
ARB_COMPLETION_MIN_SAMPLES=30
ARB_COMPLETION_MIN_STRANDED_SAMPLES=3
ARB_COMPLETION_MIN_P5_LOWER=0.70
ARB_COMPLETION_MIN_CYCLE_EV=0.01
ARB_COMPLETION_MAX_LOSS_MULTIPLE=4.0

# Dual 40c regime + adaptive hedge shadow experiment (NO live orders)
# The engine observes the opening 5/10/20 seconds and only posts both 0.40 bids
# when the opening is oscillatory/neutral rather than directional.
DUAL40_ENABLED=true
DUAL40_ENTRY_PRICE=0.40
DUAL40_SHARES=5
DUAL40_ENTRY_WINDOWS=5,10,20
DUAL40_MIN_CHOP_SCORE=70
DUAL40_MIN_RANGE_BPS=0.8
DUAL40_MAX_RANGE_BPS=8.0
DUAL40_MAX_ABS_DRIFT_BPS=4.0
DUAL40_MAX_ABS_FLOW_IMBALANCE=0.35
DUAL40_MAX_POLY_SKEW=0.12
DUAL40_ORDER_TTL_SEC=60
DUAL40_HEDGE_MAX_WAIT_SEC=12
DUAL40_HEDGE_TRIGGER_PRICE=0.70
DUAL40_STOP_BEFORE_END_SEC=20
