# ============================================================
# dual-arbitraj — ornek ortam degiskenleri (.env olarak kopyala)
# ============================================================

# ----- Calisma modu -----
# SIM  = gercek emir YOK, sadece simulasyon (VARSAYILAN, guvenli)
# DRY  = emir imzalanir ama POST edilmez (creds/imza dogrulama)
# LIVE = GERCEK emir gonderilir (dikkat!)
EXEC_MODE=SIM
LOG_LEVEL=INFO
SYMBOL=BTCUSDT

# ----- Web dashboard (net PnL / market / gostergeler) -----
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8090

# ----- Uc noktalar -----
CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
CLOB_HOST=https://clob.polymarket.com
BINANCE_WS_BASE=wss://stream.binance.com:9443/ws
DERIBIT_REST_BASE=https://www.deribit.com/api/v2
DERIBIT_CURRENCY=BTC
GAMMA_HOST=https://gamma-api.polymarket.com
# BTC 5dk up/down modu: /events/slug/btc-updown-5m-<pencere> ile aktif marketi
# cozer, 5dk'da bir donen marketi otomatik takip eder.
BTC_5M=true
GAMMA_POLL_SEC=5
# btc_5m=false iken jenerik market secimi icin slug parcasi
GAMMA_MARKET_SLUG=

# Sabit/manuel market (Gamma yerine dogrudan token id'leri ver):
MANUAL_UP_TOKEN_ID=
MANUAL_DOWN_TOKEN_ID=
MANUAL_END_TS=
MANUAL_DURATION_SEC=300

# ----- Strateji esikleri -----
OBI_MAX=0.15
ATR_MAX_PCT=0.15
ADX_MAX=20
TIME_DECAY_PCT=0.10
SATURATION_EPS=0.02
REQUIRE_SQUEEZE=false

# ----- Emir / risk -----
ENTRY_PRICE=0.40
ORDER_SIZE=5
SINGLE_LEG_TIMEOUT_SEC=180
MAX_OPEN_BOXES=1
MAX_PAIR_COST=0.97

# ----- Reconnect (exponential backoff) -----
BACKOFF_BASE_SEC=1
BACKOFF_FACTOR=2
BACKOFF_CAP_SEC=30
WS_RECV_TIMEOUT_SEC=30

# ----- CLOB gizli (yalniz DRY/LIVE; ASLA commit'leme) -----
PRIVATE_KEY=
FUNDER_ADDRESS=
SIGNATURE_TYPE=3
CHAIN_ID=137
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=
ORDER_TICK_SIZE=0.01
NEG_RISK=false
