# ============================================================
# Direction Engine vNext — SHADOW (canli emir YOK)
# BTC/ETH/SOL/XRP x 5m/15m/1h = 12 kombinasyon yon tahmini
# ============================================================
# Bu servis yalniz veri okur, tahmin eder ve kaydeder. Private key / imza /
# CLOB creds BILEREK yoktur; buraya da eklenmez.

LOG_LEVEL=INFO
DB_PATH=data/direction_engine.sqlite

# ----- FAZ KILIDI (P1 = yalniz veri; TRAINING/CALIBRATION YASAK) -----
PHASE=P1
MODEL_TRAINING_ENABLED=false
CALIBRATION_ENABLED=false

# ----- Chainlink OFFICIAL reference (5m/15m) — Polymarket RTDS Data Stream -----
# Market rules Chainlink Data Streams'i isimlendirir. Polygon push-feed aggregator
# official PTB DEGILDIR. RTDS uygulama seviyesinde her 5 sn text PING ister.
CHAINLINK_ENABLED=true
RTDS_WS_URL=wss://ws-live-data.polymarket.com
RTDS_PING_SEC=5
RTDS_DEBUG_RAW=false
MAX_REFERENCE_OPEN_ALIGNMENT_MS=5000
MAX_REFERENCE_SOURCE_AGE_MS=8000

# ----- Web dashboard -----
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8091

# ----- Kapsam -----
ASSETS=BTC,ETH,SOL,XRP
HORIZONS=5m,15m,1h

# ----- Direct Binance WS -----
BINANCE_WS_BASE=wss://stream.binance.com:9443/stream
BINANCE_REST_BASE=https://api.binance.com
BINANCE_DEPTH_MS=100
BINANCE_BOOK_SNAPSHOT_LIMIT=1000
RING_BUFFER_MAX=4000

# ----- Polymarket Gamma -----
GAMMA_HOST=https://gamma-api.polymarket.com
GAMMA_POLL_SEC=10
GAMMA_EVENT_LIMIT=200
RESOLUTION_POLL_SEC=30

# ----- Polymarket CLOB -----
CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
CLOB_HOST=https://clob.polymarket.com

# ----- Reference / PTB -----
POLY_PRICE_HOST=https://polymarket.com
CHAINLINK_REF_ENABLED=true

# ----- Snapshot / recorder -----
SNAPSHOT_CHECKPOINTS=240,180,120,90,60,45,30,20,10,5
SNAPSHOT_LOOP_MS=500

# ----- Freshness (ms) -----
MAX_SPOT_AGE_MS=2500
MAX_BOOK_AGE_MS=3000
MAX_TRANSPORT_AGE_MS=5000
MAX_SOURCE_AGE_MS=5000
MAX_CLOB_AGE_MS=6000
MAX_REFERENCE_AGE_MS=8000
MAX_CLOCK_SKEW_MS=3000

# ----- Checkpoint setleri -----
CHECKPOINTS_5M=240,180,150,120,90,60,45,30,20,10
CHECKPOINTS_15M=840,720,600,480,360,240,120,60,30
CHECKPOINTS_1H=3300,3000,2400,1800,1200,900,600,300,120,60

# ----- Backfill -----
BACKFILL_RESOLVED_MARKETS=0

# ----- Reconnect -----
BACKOFF_BASE_SEC=1.0
BACKOFF_FACTOR=2.0
BACKOFF_CAP_SEC=30.0
WS_RECV_TIMEOUT_SEC=30.0

# ----- Model (P2/P3; P1'de KAPALI) -----
PER_COMBO_MODEL_MIN_MARKETS=200
MIN_MARKETS_FOR_STATS=30
