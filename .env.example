PORT=8080
DB_PATH=data/tv_direction.sqlite
POLYMARKET_POLL_SEC=15
LOG_LEVEL=info

# Paper-only portfolio simulation (NO live orders)
PAPER_ENABLED=true
PAPER_INITIAL_BALANCE=1000
PAPER_STAKE=2.50
PAPER_MIN_CONFIDENCE=55
PAPER_MIN_SECONDS_TO_END=30
PAPER_MAX_SECONDS_TO_END=240

# Realistic paper BUY execution: CLOB ask/VWAP + fee + latency buffer
PAPER_TAKER_FEE_RATE=0.07
PAPER_LATENCY_BUFFER=0.002
# Hard paper-entry economics: fee/latency-inclusive cost and PTB terminal edge
PAPER_MAX_EFFECTIVE_ENTRY=0.85
PAPER_MIN_ECONOMIC_EDGE=0.05
# Taban giris fiyati: bunun altindaki uc-ucuz girisleri (1-4c) alma. Canlida
# kapanisa yakin o seviyeler ters-secilimle dolmaz; 10c hala 10x avantaj. 0=kapali.
PAPER_MIN_ENTRY_PRICE=0.10

# Shadow reverse hedge. This never sends a live order and never reacts to one flip.
PAPER_HEDGE_ENABLED=true
PAPER_HEDGE_WINDOW=8
PAPER_HEDGE_MIN_VOTES=6
PAPER_HEDGE_MIN_CONSECUTIVE=3
PAPER_HEDGE_SCORE_THRESHOLD=0.35
PAPER_HEDGE_MIN_PROBABILITY=0.65
PAPER_HEDGE_MIN_EDGE=0.03
PAPER_HEDGE_MIN_ABS_PTB_Z=0.50
PAPER_HEDGE_MIN_SECONDS_TO_END=20
PAPER_HEDGE_MAX_SECONDS_TO_END=120


# Maker arbitrage shadow engine. NO live orders are submitted.
# Maker fee is modeled as zero; operational buffer remains conservative.
ARB_SHADOW_ENABLED=true
ARB_TARGET_EDGE=0.02
# Paper research samples smaller positive maker edges; this is NOT a live threshold.
ARB_PAPER_MIN_EDGE=0.002
ARB_OPERATIONAL_BUFFER=0.002
ARB_UNCERTAINTY_PENALTY=0.02
# One unit = max(UP min_order_size, DOWN min_order_size), normally 5 shares.
ARB_MAX_STRANDED_UNITS=1


# Maker arbitrage paper executor (still NO live orders)
ARB_MAX_BOOK_FETCH_MS=1000
ARB_TRADE_STREAM_MAX_AGE_SEC=20
ARB_PAPER_ENABLED=true
ARB_PAPER_ORDER_TTL_SEC=12
ARB_PAPER_MAX_STRANDED_SEC=5
ARB_PAPER_STOP_BEFORE_END_SEC=12

# Arb v2 completion-probability / CycleEV policy
ARB_PAPER_SOFT_COMPLETION_SEC=2
ARB_COMPLETION_LOOKBACK=500
ARB_COMPLETION_MIN_SAMPLES=30
ARB_COMPLETION_MIN_STRANDED_SAMPLES=3
ARB_COMPLETION_MIN_P5_LOWER=0.70
ARB_COMPLETION_MIN_CYCLE_EV=0.01
ARB_COMPLETION_MAX_LOSS_MULTIPLE=4.0

# Dual 40c regime + adaptive hedge shadow experiment (NO live orders)
# The engine observes the opening 5/10/20 seconds and only posts both 0.40 bids
# when the opening is oscillatory/neutral rather than directional.
DUAL40_ENABLED=true
DUAL40_ENTRY_PRICE=0.40
DUAL40_SHARES=5
DUAL40_ENTRY_WINDOWS=5,10,20
DUAL40_MIN_CHOP_SCORE=70
DUAL40_MIN_RANGE_BPS=0.8
DUAL40_MAX_RANGE_BPS=8.0
DUAL40_MAX_ABS_DRIFT_BPS=4.0
DUAL40_MAX_ABS_FLOW_IMBALANCE=0.35
DUAL40_MAX_POLY_SKEW=0.12
DUAL40_ORDER_TTL_SEC=60
DUAL40_HEDGE_MAX_WAIT_SEC=12
DUAL40_HEDGE_TRIGGER_PRICE=0.70
DUAL40_STOP_BEFORE_END_SEC=20

# ============================================================
# Faz 3 — DRY -> tek-tik CANLI + dashboard sifre (GERCEK PARA)
# ============================================================
# Yurutme modu: shadow (varsayilan, emir YOK) | dry (kopru IMZALAR, POST YOK) |
# live (gercek emir). Baslangicta DRY; canliya dashboard butonundan gec.
DUAL40_EXEC_MODE=shadow

# --- YON TAHMINI (Model A) canli yurutme ---
# shadow (paper) | dry (kopru imzalar, POST yok) | live (gercek marketable BUY).
# NOT: canli emir icin engine icindeki aktivasyon satiri elle eklenmis olmali.
DIRECTION_EXEC_MODE=shadow
DIRECTION_LIVE_STAKE=1        # canli emir basi USD (min ~1)

# --- KOPRU (Go beyni -> Python executor_bridge.py -> py-clob-client v2) ---
# Imzalama Go'da DEGIL; resmi kutuphaneyi saran yerel kopruye yaptirilir (V2 +
# signatureType/POLY_1271 dogru). Go yalniz kopruye HTTP yapar.
EXECUTOR_URL=http://127.0.0.1:8099
EXECUTOR_TOKEN=            # kopruyle paylasilan sir (guclu rastgele bir string)

# --- ASAGIDAKILER KOPRUNUN env'i (executor_bridge.py okur; ayni .env'i paylasabilir) ---
# CLOB imzalama secrets — ASLA paylasma/commitleme.
PRIVATE_KEY=              # imzalayici EOA
CLOB_HOST=https://clob.polymarket.com
CHAIN_ID=137
# Cuzdan tipi: 0=EOA, 1=POLY_PROXY (email/magic), 2=POLY_GNOSIS_SAFE (MetaMask),
# 3=POLY_1271 (akilli-kontrat cuzdan). !=0 ise FUNDER_ADDRESS = paranin oldugu adres.
SIGNATURE_TYPE=3
FUNDER_ADDRESS=
# L2 API creds (kopru bunlari da okur). live icin gerekli.
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=
ORDER_TICK_SIZE=0.01
NEG_RISK=false

# Dashboard giris (ikisi de dolu olmali ki koruma AKTIF olsun)
DASHBOARD_USER=admin
DASHBOARD_PASS=
DASHBOARD_SESSION_SECRET=
DASHBOARD_SESSION_TTL_MIN=720

# --- Faz 4: Model B (yeni mikroyapi beyni) + gercekci fill ---
DUAL40_FILL_MODEL=realistic          # realistic (dogru) | legacy (iyimser, A/B)
DUAL40_MODELB_GATE=true              # Model B kutu girisini filtreler (kaotik/asimetrik -> girme)
DUAL40_MODELB_MIN_COHERENCE=0.20     # band coherence esigi (gevsetildi)
DUAL40_MODELB_MIN_QUEUE_SYM=0.15     # kuyruk simetri esigi (gevsetildi)

# --- Sadelestirilmis giris (TEK FILTRE) ---
# true => acilis penceresinde (ilk EntrySeconds sn) volatil hareket yoksa
# (RangeBps <= SIMPLE_MAX_RANGE_BPS) dogrudan gir. Diger tum kapilar devre disi.
DUAL40_SIMPLE_ENTRY=true
DUAL40_SIMPLE_MAX_RANGE_BPS=12       # acilis 25sn range bu esigin altiysa gir
DUAL40_ENTRY_WINDOWS=25,45,70        # 25sn birincil; 45/70 zamanlama/PTB gecikene ikinci sans
