# ------------------------------------------------------------------
# GUVENLIK: Bu dosyayi .env olarak kopyala, gercek degerleri gir.
# .env ASLA commit edilmez (.gitignore'da).
# ------------------------------------------------------------------

# --- Polymarket / Polygon cuzdan ---
# Kucuk sermayeli ADANMIS bir cuzdan kullan. Ana cuzdanini KULLANMA.
PRIVATE_KEY=0xYOUR_POLYGON_WALLET_PRIVATE_KEY
CLOB_HOST=https://clob.polymarket.com
CHAIN_ID=137

# API kimlik bilgileri (bos birakirsan private key'den turetilir)
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=

# --- Fiyat kaynagi (BTC spot) ---
# DIKKAT: Bu, marketin resolution kaynagi ile AYNI olmali (Pyth/Chainlink vs).
# Binance yalnizca proxy'dir; gercek resolution kaynagini dogrula!
BINANCE_WS=wss://stream.binance.com:9443/ws/btcusdt@trade

# --- Market secimi ---
# auto:   Aktif 5dk BTC marketini /markets/slug/btc-updown-5m-<ts> ile otomatik bulur
#         + her 5dk yeni markete otomatik gecer (rollover). ONERILEN.
# manual: MARKET_* degerlerini elle gir (tek market, gecis yok)
MARKET_MODE=auto
MARKET_YES_TOKEN_ID=
MARKET_NO_TOKEN_ID=
# priceToBeat (strike). manual modda zorunlu. auto modda cozulmeye calisilir.
MARKET_STRIKE=
# Marketin cozulme (resolution) epoch zamani, saniye cinsinden UNIX. manual modda zorunlu.
MARKET_RESOLVE_TS=

# --- Guvenlik / calisma modu ---
# true: HICBIR gercek emir gonderilmez, sadece sinyal loglanir (paper trade)
# false: GERCEK emir gonderir. Once true ile en az birkac market izle!
DRY_RUN=true

# --- Strateji parametreleri (BOX / cift-bacak) ---
# maker: 0.40'a resting bid koy, volatilite doldursun (ucuz gir, spread kazan) [ONERILEN]
# taker: ask hedefe dusunce al (garanti fill, ugrassiz, spread'i sen odersin)
LEG_MODE=maker
# Sadece |spot - strike| bu degerin altindayken calis (USD). Strike'a yakin = iyi fill.
PROX_MAX_USD=5
# Ilk bacagi bu fiyattan (veya ucuza) yakala (0-1). Senin "40 cent" hedefin.
TARGET_LEG_PRICE=0.40
# Iki bacagin toplam maliyeti bunu ASLA gecmesin. <1.00 => garanti kar.
MAX_PAIR_COST=0.97
# Kilitlemek icin minimum kar marji (fiyat birimi)
MIN_PROFIT=0.03
# Her bacakta alinacak hisse adedi (garanti odeme = adet * $1)
PAIR_SHARES=10
# Bu sureden sonra (kalan sn) yeni ILK bacak ACMA; sadece tamamla/iptal
COMPLETE_DEADLINE_SEC=20
# Tek bacak varken bu sureden sonra tamamla-ya-da-iptal karari (kalan sn)
FLATTEN_SEC=6
# Tamamlanamayan tek bacak: sell (bacagi sat, riski kapat) | hold (resolution'a tut, 50/50)
ABORT_MODE=sell

# --- Risk limitleri ---
# Tek markette maksimum acik nominal (USD)
MAX_POSITION_USD=30
# Gunluk maksimum zarar (USD) -> asilinca bot durur (kill switch)
MAX_DAILY_LOSS_USD=20
# Tek markette maksimum islem sayisi
MAX_TRADES_PER_MARKET=6
# Zarardan sonra bekleme (saniye)
LOSS_COOLDOWN_SEC=10
# Emirlerde izin verilen kayma (slippage), fiyat biriminde
SLIPPAGE=0.02
