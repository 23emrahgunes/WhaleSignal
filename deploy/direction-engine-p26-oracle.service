[Unit]
Description=Direction Engine P2.6 Oracle Persistence Sidecar
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/direction-engine
EnvironmentFile=-/home/ubuntu/direction-engine/.env.p26
ExecStart=/home/ubuntu/direction-engine/.venv/bin/python p26_oracle_daemon.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/ubuntu/direction-engine/data /home/ubuntu/direction-engine/logs
StandardOutput=append:/home/ubuntu/direction-engine/logs/p26-oracle.log
StandardError=append:/home/ubuntu/direction-engine/logs/p26-oracle.log

[Install]
WantedBy=multi-user.target
