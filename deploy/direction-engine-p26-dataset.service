[Unit]
Description=Direction Engine P2.6 Canonical Dataset Sidecar
After=direction-engine-p26-oracle.service
Wants=direction-engine-p26-oracle.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/direction-engine
EnvironmentFile=-/home/ubuntu/direction-engine/.env.p26
ExecStart=/home/ubuntu/direction-engine/.venv/bin/python p26_dataset_daemon.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/ubuntu/direction-engine/data /home/ubuntu/direction-engine/logs
StandardOutput=append:/home/ubuntu/direction-engine/logs/p26-dataset.log
StandardError=append:/home/ubuntu/direction-engine/logs/p26-dataset.log

[Install]
WantedBy=multi-user.target
