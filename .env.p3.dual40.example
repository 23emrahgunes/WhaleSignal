# P3 DUAL40 Maker Recovery — process starts DRY; LIVE requires authenticated arm
P3_STRATEGY_MODE=DUAL40_MAKER_RECOVERY_V1
P3_P26_DB_PATH=data/p26_research.sqlite
P3_DB_PATH=data/p3_arbitrage.sqlite
P3_REPORTS_DIR=reports/p3
P3_SCAN_INTERVAL_MS=250
P3_MAX_QUANTITY_SHARES=30
P3_MAX_CAPITAL_PER_CYCLE_USDC=30

# 40¢ + 40¢ maker ladder. These three values are hard-locked by config validation.
P3_DUAL40_PAPER_ENABLED=true
P3_DUAL40_ASSETS=BTC,ETH,SOL,XRP
P3_DUAL40_HORIZON=5m
P3_DUAL40_PRICE=0.40
P3_DUAL40_LADDER=5,10,30

# Stable / balanced / non-directional entry gate.
P3_DUAL40_MARKET_AGE_SEC=30
P3_DUAL40_MIN_TTE_SEC=90
P3_DUAL40_CANCEL_TTE_SEC=40
P3_DUAL40_LOOKBACK_SEC=20
P3_DUAL40_CONFIRM_SEC=5
P3_DUAL40_BALANCED_MID_LOW=0.44
P3_DUAL40_BALANCED_MID_HIGH=0.56
P3_DUAL40_MAX_MID_RANGE=0.10
P3_DUAL40_MAX_NET_DRIFT=0.04
P3_DUAL40_MAX_ABS_SLOPE_PER_SEC=0.0030
P3_DUAL40_MAX_ONE_WAY_RATIO=0.72
P3_DUAL40_MAX_SINGLE_JUMP=0.06
P3_DUAL40_MAX_COMPLEMENT_RESIDUAL=0.04
P3_DUAL40_MAX_SPREAD_EACH=0.10
P3_DUAL40_NEAR_TOUCH_PRICE=0.41
P3_DUAL40_BOOK_FRESH_MS=1500

# Resting-order safety and reconciliation.
P3_DUAL40_HEARTBEAT_SEC=5
P3_DUAL40_BALANCE_POLL_SEC=1
P3_DUAL40_RESOLUTION_POLL_SEC=10
P3_DUAL40_GAMMA_HOST=https://gamma-api.polymarket.com
# Full 5 -> 10 -> 30 ladder needs $30 mathematically; $35 includes reserve.
P3_DUAL40_MIN_COLLATERAL_TO_ARM_USDC=35
P3_DUAL40_FILL_EPSILON=0.00001

# Guarded LIVE capability. The daemon still starts DRY after every restart.
P3_LIVE_FEATURE_ENABLED=true
P3_LIVE_AUTO_EXECUTE_ENABLED=true
P3_LIVE_REQUIRE_DRY_VALIDATED=false
P3_LIVE_CLOB_HOST=https://clob.polymarket.com
P3_LIVE_CHAIN_ID=137
P3_LIVE_GEOBLOCK_URL=https://polymarket.com/api/geoblock
P3_LIVE_REQUIRE_GEOBLOCK_CLEAR=true
P3_LIVE_SETTLEMENT_WAIT_SEC=15
P3_LIVE_SETTLEMENT_POLL_SEC=0.5

# 8093 must be authenticated whenever LIVE capability is enabled.
P3_WEB_ENABLED=true
P3_WEB_HOST=0.0.0.0
P3_WEB_PORT=8093
P3_WEB_REFRESH_MS=3000
P3_WEB_AUTH_REQUIRED=true
P3_WEB_USERNAME=operator
P3_WEB_PASSWORD=REPLACE_WITH_AT_LEAST_12_CHARACTERS
P3_WEB_SESSION_TTL_SEC=43200
P3_WEB_LOGIN_MAX_FAILURES=5
P3_WEB_LOGIN_WINDOW_SEC=600
P3_WEB_COOKIE_SECURE=false

# LIVE secrets belong only in VPS .env.p3. Never commit real values.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_WALLET=
POLYMARKET_FUNDER=
POLYMARKET_SIGNATURE_TYPE=3
POLYMARKET_CLOB_API_KEY=
POLYMARKET_CLOB_API_SECRET=
POLYMARKET_CLOB_API_PASSPHRASE=
