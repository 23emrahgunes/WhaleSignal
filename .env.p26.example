# P2.6 isolated research challenger. SHADOW/PAPER only.
P26_P25_DB_PATH=data/direction_engine.sqlite
P26_DB_PATH=data/p26_research.sqlite
P26_BACKUP_ROOT=data/backups
P26_MODEL_DIR=models/p26
P26_REPORTS_DIR=reports/p26

# P2.6.0 baseline freeze / local P2.5 APIs
P26_P25_STATE_URL=http://127.0.0.1:8091/api/state
P26_P25_PAPER_SUMMARY_URL=http://127.0.0.1:8091/api/paper-summary
P26_BASELINE_REQUIRE_CLEAN_GIT=true

# P2.6.1 independent Chainlink RTDS sidecar + canonical rows
P26_RTDS_WS_URL=wss://ws-live-data.polymarket.com
P26_ORACLE_QUEUE_MAX=20000
P26_ORACLE_BATCH_SIZE=200
P26_ORACLE_FLUSH_INTERVAL_MS=250
P26_ORACLE_RETENTION_DAYS=30
P26_CANONICAL_MAX_LAG_MS=2000
P26_CANONICAL_CHECKPOINT_5M=60
P26_CANONICAL_CHECKPOINT_15M=240
P26_CANONICAL_CHECKPOINT_1H=600
P26_DATASET_LABEL_SYNC_INTERVAL_SEC=60
P26_DATASET_MAX_SNAPSHOT_BATCH=5000

# P2.6.2 frozen external-only champion
P26_MODEL_MIN_TRAIN_MARKETS=150
P26_MODEL_MIN_CLASS_MARKETS=50
P26_MODEL_REGULARIZATION_C=1.0
P26_MODEL_RANDOM_SEED=26

# P2.6.3 purged/embargoed walk-forward + latency
P26_WALKFORWARD_EMBARGO_MS=3600000
P26_MAX_SOURCE_SKEW_MS=1000
P26_MAX_DECISION_DATA_LAG_MS=1000
P26_MAX_QUOTE_AGE_AT_FILL_MS=500
P26_MAX_FORECAST_AGE_MS=2000

# P2.6.4 chronological OOS calibration
P26_CALIBRATION_BUCKET_WIDTH=0.05
P26_CALIBRATION_MIN_BUCKET_N=30
P26_CALIBRATION_Z=1.96

# P2.6.5 RESEARCH_PAPER_V2. Initial hypotheses, not claimed optimal.
P26_PAPER_V2_STRATEGY_VERSION=RESEARCH_PAPER_V2
P26_PAPER_V2_STAKE_USDC=2.50
P26_PAPER_V2_MIN_NET_EDGE=0.02
P26_PAPER_V2_SAFETY_BUFFER=0.005
P26_PAPER_V2_FEE_BPS=0
P26_PAPER_V2_MIN_FILL_FRACTION=1.0
P26_PAPER_V2_MAX_SPREAD=0.15
P26_PAPER_V2_MIN_DEPTH_PERSISTENCE_MS=250
P26_PAPER_V2_MAX_FLICKER_RATE=0.85
P26_PAPER_V2_MAX_CANCEL_TO_ADD_RATIO=8.0

# P2.6.6 promotion ceiling is VALIDATED_PAPER_MODEL, never live execution.
P26_PROMOTION_MIN_OOS_MARKETS=300
P26_PROMOTION_MIN_OOS_CLASS_MARKETS=75
P26_PROMOTION_MIN_PAPER_TRADES=100
P26_PROMOTION_BOOTSTRAP_BLOCKS=2000
P26_PROMOTION_BLOCK_HOURS=6
P26_PROMOTION_MIN_POSITIVE_FOLD_FRACTION=0.60
P26_PROMOTION_MAX_ASSET_CONCENTRATION=0.80
P26_PROMOTION_MAX_HORIZON_CONCENTRATION=0.80
P26_PROMOTION_MAX_DRAWDOWN_FRACTION=0.25

# P2.6.5 fail-closed shadow Paper V2 runtime. Disabled until frozen OOS
# model/calibration/alpha artifacts exist and pass research gates.
P26_PAPER_V2_ENABLED=false
P26_CLOB_HTTP_URL=https://clob.polymarket.com
P26_CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
P26_BOOK_MARKET_REFRESH_SEC=30
P26_BOOK_PERSIST_MIN_INTERVAL_MS=100
P26_BOOK_HISTORY_RETENTION_HOURS=72
P26_PAPER_V2_MODEL_MANIFEST=models/p26/fair_value_v1.manifest.json
P26_PAPER_V2_ALPHA_ARTIFACT=models/p26/alpha_profile_v1.json
P26_PAPER_V2_ALPHA_MIN_SAMPLES=30
P26_PAPER_V2_ALPHA_TTL_QUANTILE=0.20
P26_PAPER_V2_FILL_DELAY_MS=100
P26_PAPER_V2_APPROVED_CALIBRATION_SCOPES=PER_COMBO
P26_PAPER_V2_APPROVED_ALPHA_SCOPES=PER_COMBO
P26_PAPER_V2_INITIAL_EQUITY_USDC=1000
P26_PAPER_V2_MAX_OPEN_POSITIONS_TOTAL=4
P26_PAPER_V2_MAX_OPEN_EXPOSURE_USDC=10
P26_PAPER_V2_MAX_EXPOSURE_PER_ASSET_USDC=3.0
P26_PAPER_V2_MAX_EXPOSURE_PER_HORIZON_USDC=5
P26_PAPER_V2_MAX_OVERLAPPING_POSITIONS_PER_ASSET=1
P26_PAPER_V2_MAX_CRYPTO_CLUSTER_EXPOSURE_USDC=10
P26_PAPER_V2_DAILY_LOSS_LIMIT_USDC=25
P26_PAPER_V2_MAX_DRAWDOWN_FRACTION=0.10
P26_PAPER_V2_CONSECUTIVE_LOSS_LIMIT=3
P26_PAPER_V2_COOLDOWN_SEC=900
P26_PAPER_V2_GLOBAL_KILL_SWITCH=false
