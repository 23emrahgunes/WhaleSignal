# Direction Engine vNext — P2.5 SHADOW + PAPER
# BTC/ETH/SOL/XRP x 5m/15m/1h. No private key, signing or execution.

LOG_LEVEL=INFO
DB_PATH=data/direction_engine.sqlite

# P2.2-P2.5 capabilities
PHASE=P2.5
MODEL_TRAINING_ENABLED=true
CALIBRATION_ENABLED=true
FORECAST_RECORDING_ENABLED=true

MODEL_PATH=models/direction_model.pkl
CALIBRATION_PATH=models/calibration_book.pkl
MODEL_MIN_MARKETS_PREDICT=20
PER_COMBO_MODEL_MIN_MARKETS=200
MIN_MARKETS_FOR_STATS=30

# Conservative defaults until enough prequential resolved forecasts exist
DEFAULT_THRESHOLD_5M=0.62
DEFAULT_THRESHOLD_15M=0.60
DEFAULT_THRESHOLD_1H=0.58
THRESHOLD_MIN_SAMPLES=60
THRESHOLD_MIN_COVERED=24
THRESHOLD_TARGET_ACCURACY=0.56
CALIBRATION_MIN_SAMPLES=50
CALIBRATION_MIN_BIN_SAMPLES=12
CALIBRATION_PRIOR_STRENGTH=20
PREDICTABILITY_MIN_5M=0.60
PREDICTABILITY_MIN_15M=0.58
PREDICTABILITY_MIN_1H=0.56

# Paper trading — SQLite simulation only.
# CHECKPOINT keeps the historical T-60/T-240/T-600 policy.
# DEEP_VALUE_WATCH watches every engine tick and opens at most one $1 paper entry
# per market when the forecast side reaches <=10c and P2.6 proves enough fresh depth.
PAPER_TRADING_ENABLED=true
PAPER_ENTRY_MODE=CHECKPOINT
PAPER_STRATEGY_VERSION=RESEARCH_PAPER_V1
PAPER_STARTING_BANKROLL_USDC=1000
PAPER_STAKE_USDC=2.50
PAPER_ENTRY_CHECKPOINT_5M=60
PAPER_ENTRY_CHECKPOINT_15M=240
PAPER_ENTRY_CHECKPOINT_1H=600
PAPER_MIN_CONFIDENCE=0.05
PAPER_MIN_AGREEMENT=0.50
PAPER_MIN_EDGE=0.00
PAPER_MIN_PRICE=0.05
PAPER_MAX_PRICE=0.95
PAPER_SLIPPAGE=0.005
PAPER_FEE_BPS=0
PAPER_ALLOWED_STATUSES=PROVISIONAL,VALIDATED
PAPER_ALLOWED_GRADES=LOW,MEDIUM,HIGH
PAPER_RECENT_LIMIT=50

# Recommended deep-value research profile:
# PAPER_ENTRY_MODE=DEEP_VALUE_WATCH
# PAPER_STRATEGY_VERSION=DEEP_VALUE_10C_V1
# PAPER_STAKE_USDC=1.00
PAPER_DEEP_VALUE_MIN_ASK=0.01
PAPER_DEEP_VALUE_MAX_ASK=0.10
PAPER_DEEP_VALUE_PREFILTER_BUFFER=0.03
PAPER_DEEP_VALUE_MIN_TTE_SEC=5
PAPER_DEEP_VALUE_P26_DB_PATH=data/p26_research.sqlite
PAPER_DEEP_VALUE_MAX_BOOK_AGE_MS=1500
PAPER_DEEP_VALUE_REQUIRE_DEPTH=true
PAPER_DEEP_VALUE_REQUIRE_FEE_SCHEDULE=true
PAPER_DEEP_VALUE_MIN_VALUE_MULTIPLE=1.50

CHAINLINK_ENABLED=true
RTDS_WS_URL=wss://ws-live-data.polymarket.com
RTDS_PING_SEC=5
RTDS_DEBUG_RAW=false
MAX_REFERENCE_OPEN_ALIGNMENT_MS=5000
MAX_REFERENCE_CLOSE_ALIGNMENT_MS=8000
MAX_REFERENCE_SOURCE_AGE_MS=8000

WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8091

ASSETS=BTC,ETH,SOL,XRP
HORIZONS=5m,15m,1h

BINANCE_WS_BASE=wss://stream.binance.com:9443/stream
BINANCE_REST_BASE=https://api.binance.com
BINANCE_DEPTH_MS=100
BINANCE_BOOK_SNAPSHOT_LIMIT=1000
RING_BUFFER_MAX=4000
FEATURE_PRICE_RING_MAX=24000

GAMMA_HOST=https://gamma-api.polymarket.com
GAMMA_POLL_SEC=10
GAMMA_EVENT_LIMIT=200
RESOLUTION_POLL_SEC=30

CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
CLOB_HOST=https://clob.polymarket.com
POLY_PRICE_HOST=https://polymarket.com
CHAINLINK_REF_ENABLED=true

SNAPSHOT_LOOP_MS=500
CHECKPOINTS_5M=240,180,150,120,90,60,45,30,20,10
CHECKPOINTS_15M=840,720,600,480,360,240,120,60,30
CHECKPOINTS_1H=3300,3000,2400,1800,1200,900,600,300,120,60
BACKFILL_RESOLVED_MARKETS=0

MAX_SPOT_AGE_MS=2500
MAX_BOOK_AGE_MS=3000
MAX_TRANSPORT_AGE_MS=5000
MAX_SOURCE_AGE_MS=5000
MAX_CLOB_AGE_MS=6000
MAX_REFERENCE_AGE_MS=8000
MAX_CLOCK_SKEW_MS=3000

BACKOFF_BASE_SEC=1.0
BACKOFF_FACTOR=2.0
BACKOFF_CAP_SEC=30.0
WS_RECV_TIMEOUT_SEC=30.0
